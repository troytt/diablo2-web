{
  "name": "d2web",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Web-native Diablo II engine: reads assets from a user-supplied classic MPQ. No game assets are bundled.",
  "scripts": {
    "bake": "tsx src/baker/cli.ts",
    "bake:verify": "tsx src/baker/cli.ts --verify",
    "verify:audio": "tsx tools/verify-audio.ts",
    "verify:tbl": "tsx tools/verify-tbl.ts",
    "verify:formats": "tsx tools/verify-formats.ts",
    "dev": "vite",
    "build": "tsc --noEmit && tsx src/baker/io/asset-manifest.ts && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.common.json --noEmit && tsc -p tsconfig.netproto.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.sw.json --noEmit && tsc -p tsconfig.baker.json --noEmit && tsc -p tsconfig.json --noEmit",
    "extract:d2net": "tsx src/baker/extract/extract-d2net-tables.ts",
    "extract:d2net-tables": "tsx src/baker/extract/extract-d2net-tables.ts",
    "extract:levels-meta": "tsx src/baker/extract/gen-levels-meta.ts",
    "extract:level-monster-plans": "tsx src/baker/extract/gen-level-monster-plans.ts",
    "extract:light-sources": "tsx src/baker/extract/gen-light-sources.ts",
    "extract:objects-txt": "tsx src/baker/extract/gen-objects-txt.ts",
    "extract:levels-monlvl": "tsx src/baker/extract/gen-levels-monlvl-113c.ts",
    "extract:fog-sin": "tsx src/baker/extract/gen-fog-sin-table.ts",
    "extract:object-sounds": "tsx src/baker/extract/gen-object-sounds.ts",
    "extract:state-sounds": "tsx src/baker/extract/gen-state-sounds.ts",
    "extract:quest-fx-data": "tsx src/baker/extract/gen-quest-fx-data.ts",
    "bot": "tsx tools/d2-bot.ts",
    "d2:bot": "tsx tools/d2-bot.ts",
    "netproto:replay": "tsx tools/netproto-replay.ts",
    "d2:replay": "tsx tools/netproto-replay.ts",
    "pack": "tsx src/baker/cli.ts acts",
    "pack:manifest": "tsx src/baker/io/asset-manifest.ts",
    "pack:tiles": "tsx src/baker/packers/pack-tiles.ts",
    "d2s:unlock": "tsx tools/d2s-unlock.ts",
    "verify:play": "tsx tools/verify-play.ts",
    "inspect": "tsx tools/inspect-mpq.ts",
    "verify:d2": "tsx tools/verify-d2-data.ts",
    "verify:implode": "tsx tools/verify-implode.ts",
    "verify:collision-orientation": "tsx tools/verify-collision-orientation.ts",
    "verify:renderer": "tsx tools/verify-renderer-lifecycle.ts",
    "verify:level-entry-title": "tsx tools/verify-level-entry-title-browser.ts",
    "verify:all": "tsx tools/verify-combat.ts && tsx tools/verify-items.ts && tsx tools/verify-collision-orientation.ts && tsx tools/verify-tbl.ts && tsx tools/verify-audio.ts && tsx tools/verify-formats.ts",
    "verify:acts": "tsx tools/verify-acts.ts",
    "verify:monsters": "tsx tools/verify-monsters.ts",
    "verify:world-graph": "tsx tools/verify-world-graph.ts samples/d2",
    "verify:world-walk": "tsx tools/verify-world-walk.ts",
    "build:game": "tsx src/baker/io/asset-manifest.ts && vite build --base=/diablo2/ --outDir dist-game",
    "pack:data": "tsx src/baker/packers/pack-act-assets.ts",
    "pack:acts": "tsx src/baker/packers/pack-act-assets.ts",
    "pack:ui": "tsx src/baker/packers/pack-ui.ts",
    "pack:level-entry-titles": "tsx src/baker/packers/pack-level-entry-titles.ts",
    "pack:frontend": "tsx src/baker/packers/pack-frontend-ui.ts",
    "pack:animdata": "tsx src/baker/packers/pack-animdata.ts",
    "pack:entities": "tsx src/baker/packers/pack-entity-assets.ts",
    "pack:char-so": "tsx src/baker/packers/pack-char-so-layers.ts",
    "pack:missiles": "tsx src/baker/packers/pack-missiles.ts",
    "pack:overlays": "tsx src/baker/packers/pack-overlays.ts",
    "pack:weather": "tsx src/baker/packers/pack-weather.ts",
    "pack:sound-tables": "tsx src/baker/cli.ts sound-tables",
    "pack:sfx": "tsx src/baker/cli.ts sfx",
    "pack:music": "tsx src/baker/cli.ts music",
    "pack:ambient-sounds": "tsx src/baker/cli.ts ambient-sounds",
    "pack:skill-sounds": "tsx src/baker/cli.ts skill-sounds",
    "pack:monster-sounds": "tsx src/baker/cli.ts monster-sounds",
    "pack:speech": "tsx src/baker/cli.ts speech",
    "verify:entity-packs": "tsx src/baker/audit/verify-entity-packs.ts",
    "verify:entities": "tsx src/baker/audit/verify-entity-packs.ts",
    "verify:packs": "tsx src/baker/audit/verify-packs.ts",
    "verify:bundle-no-mpq": "tsx tools/verify-bundle-no-mpq.ts",
    "verify:deploy": "tsx tools/verify-deploy.ts",
    "verify:listfile": "tsx tools/verify-listfile.ts",
    "verify:object-lookup": "tsx tools/verify-object-lookup.ts",
    "port:object-lookup": "tsx src/baker/extract/port-object-lookup.ts",
    "verify:alignment": "tsx src/baker/audit/verify-tile-alignment.ts",
    "verify:tiles": "tsx src/baker/audit/verify-tiles.ts",
    "publish:packs": "tsx src/baker/io/publish-packs.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@vitest/coverage-v8": "^2.1.9",
    "tsx": "^4.23.13",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.9"
  }
}
