{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],
    "noEmit": true
  },
  "include": [
    "src/baker/**/*.ts",
    "src/common/**/*.ts",
    "src/common/**/*.d.ts"
  ],
  "exclude": [
    "src/client",
    "src/client/**",
    "src/server",
    "src/server/**",
    "src/netproto",
    "src/netproto/**",
    "tools",
    "tools/**",
    "tests",
    "tests/**"
  ]
}
